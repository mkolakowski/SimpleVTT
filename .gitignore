__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
config/config.yaml
backups/
app/static/uploads/
*.sqlite
*.db
.DS_Store

# Claude Code local state (per-machine, should not be shared)
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/*.lock

# Harness run artifacts (scripts/run_harness.sh) — keep the dir, ignore runs
test-results/*
!test-results/.gitkeep

# Visual-snapshot current-run artifacts — baselines are Linux-baked; local
# (macOS) runs regenerate *.current.png diffs that should never be committed
tests/harness_ui/__snapshots__/*.current.png
