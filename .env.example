# SimpleVTT — environment configuration
# Copy this file to .env and fill in real values. All application
# settings live here; there is no separate config.yaml.

# ---------- GHCR image tag (docker-compose.ghcr.yml only) ----------
# Controls which pre-built image tag is pulled when using docker-compose.ghcr.yml.
# Options:  latest   → current stable release (default)
#           dev      → latest dev-branch build
#           0.20.0   → pinned to a specific release
# Not used by docker-compose.yml (which builds from source).
#SIMPLEVTT_TAG=latest

# ---------- App ----------

# Public-facing port (host port). The container also listens on this port.
APP_PORT=8013

# Used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Public base URL — used for OAuth redirect URIs. Match this to however
# users will reach the app (port included if non-standard).
APP_BASE_URL=http://localhost:8013

# Allow self-service account creation on the login page.
APP_ALLOW_LOCAL_REGISTRATION=true

# Comma-separated list of admin emails. Anyone whose email matches one of
# these (case-insensitive) is auto-promoted to admin on login. Works for
# both local accounts and Google SSO.
ADMINS=example@example.com

# Comma-separated list of character sheet templates that should be
# selectable in the UI. Defaults to the two built-ins.
CHARACTER_TEMPLATES=generic,dnd5e

# Default UI theme applied to new users and logged-out pages.
# Valid values: dark, midnight, dim, light, forest, bubblegum, fire, oled,
#               hobbiton, hearthstone, mosswood, inkwell, forge, sepia
APP_DEFAULT_THEME=sepia

# ---------- Google SSO (optional) ----------
# Setup: https://console.cloud.google.com/apis/credentials
#  1. Create an OAuth 2.0 Client ID (Web application).
#  2. Add authorized redirect URI: ${APP_BASE_URL}/auth/google/callback
GOOGLE_SSO_ENABLED=false
GOOGLE_SSO_CLIENT_ID=
GOOGLE_SSO_CLIENT_SECRET=

# ---------- Database ----------

POSTGRES_USER=simplevtt
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=simplevtt

# ---------- Backups ----------

# Cron expression (UTC) for the backup sidecar.
BACKUP_CRON=0 3 * * *
KEEP_DAILY=7
KEEP_WEEKLY=4

# ---------- Demo mode (v2.3.0) ----------
# Public-demo deployment. When DEMO_MODE=true, the lifespan handler
# wipes-and-seeds three demo accounts + a sample campaign on a fixed
# interval. NEVER enable on production — the wipe surgically removes
# any data tagged with the demo emails / campaign name. See
# docs/plans/demo-mode.md for the full design.
DEMO_MODE=false
# Reset cadence in minutes. Clamped to [5, 1440]. Default 60.
DEMO_RESET_INTERVAL_MINUTES=60
# Run the wipe-and-seed once on boot so the first visitor always sees a
# clean slate (recommended). Default true.
DEMO_RESET_ON_BOOT=true
# Show the three demo credentials on the login page. Set false to keep
# the demo URL accessible but require visitors to know the password.
DEMO_CREDENTIALS_VISIBLE=true
