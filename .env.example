# SimpleVTT — environment configuration
# Copy this file to .env and fill in real values. All application
# settings live here; there is no separate config.yaml.

# ---------- GHCR image tag (docker-compose.ghcr.yml only) ----------
# Controls which pre-built image tag is pulled when using docker-compose.ghcr.yml.
# Options:  latest   → current stable release (default)
#           dev      → latest dev-branch build
#           0.20.0   → pinned to a specific release
# Not used by docker-compose.yml (which builds from source).
#SIMPLEVTT_TAG=latest

# ---------- App ----------

# Public-facing port (host port). The container also listens on this port.
APP_PORT=8013

# ---------- Admin Center (v2.483.0) ----------
# Standalone read-only operator dashboard (logs, traffic stats,
# fail2ban bans, data inventory) on its own port. On by default in
# docker-compose. Sign in via its own login PAGE (v2.485.3) with the
# credentials below — independent of the main app login. CHANGE
# ADMIN_CENTER_PASS before exposing it off-host (the login page +
# dashboard show a warning banner while the default is in use).
ADMIN_CENTER_PORT=8015
ADMIN_CENTER_USER=admin
ADMIN_CENTER_PASS=changeme
# Timezone the admin-center dashboard renders times in (audit-log line
# timestamps + fail2ban ban times). IANA name; default US Eastern,
# DST-aware (shows EST in winter / EDT in summer). Display-only — it
# does not change what the app writes to the audit log. Set e.g. UTC
# or America/Los_Angeles to taste.
ADMIN_CENTER_TZ=America/New_York
# Optional: secret used to sign the admin-center login session cookie.
# Leave blank to reuse APP_SECRET_KEY. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_CENTER_SECRET_KEY=
# Login brute-force throttle: lock an IP out after this many failed
# sign-ins within the window (seconds). Behind a proxy/tunnel, set
# TRUSTED_PROXY_HOPS so the throttle keys on the real client IP, not
# the proxy's (otherwise one lockout blocks everyone).
ADMIN_CENTER_LOGIN_MAX_ATTEMPTS=5
ADMIN_CENTER_LOGIN_WINDOW_SECONDS=900
# Opt-in TOTP two-factor auth on the admin-center login (v2.486.x).
# Default OFF. To enable:
#   1. Generate a base32 secret:
#      python -c "import secrets,base64; print(base64.b32encode(secrets.token_bytes(20)).decode().rstrip('='))"
#   2. Put it in ADMIN_CENTER_TOTP_SECRET and add the same string to your
#      authenticator app (Google Authenticator / Aegis / 1Password — use
#      "enter a setup key" / manual entry).
#   3. Set ADMIN_CENTER_MFA_ENABLED=true and restart.
# If MFA is enabled with a blank secret the login FAILS CLOSED (refuses
# all logins) rather than silently allowing password-only.
# ADMIN_CENTER_RECOVERY_CODE is a single break-glass code accepted in
# place of a TOTP code if you lose your authenticator. BLANK BY DEFAULT
# — while blank, NO recovery code is accepted. Set a long random value
# and store it offline; it is one-shot per container run (rotate +
# restart after use). See docs/plans/admin-center-mfa.md.
ADMIN_CENTER_MFA_ENABLED=false
ADMIN_CENTER_TOTP_SECRET=
ADMIN_CENTER_RECOVERY_CODE=

# Used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Public base URL — used for OAuth redirect URIs. Match this to however
# users will reach the app (port included if non-standard).
APP_BASE_URL=http://localhost:8013

# Allow self-service account creation on the login page.
APP_ALLOW_LOCAL_REGISTRATION=true

# Comma-separated list of admin emails. Anyone whose email matches one of
# these (case-insensitive) is auto-promoted to admin on login. Works for
# both local accounts and Google SSO.
ADMINS=example@example.com

# Comma-separated list of character sheet templates that should be
# selectable in the UI. Defaults to the two built-ins.
CHARACTER_TEMPLATES=generic,dnd5e

# Default UI theme applied to new users and logged-out pages.
# Valid values: dark, midnight, dim, light, forest, bubblegum, fire, oled,
#               hobbiton, hearthstone, mosswood, inkwell, forge, sepia
APP_DEFAULT_THEME=sepia

# ---------- Google SSO (optional) ----------
# Setup: https://console.cloud.google.com/apis/credentials
#  1. Create an OAuth 2.0 Client ID (Web application).
#  2. Add authorized redirect URI: ${APP_BASE_URL}/auth/google/callback
GOOGLE_SSO_ENABLED=false
GOOGLE_SSO_CLIENT_ID=
GOOGLE_SSO_CLIENT_SECRET=

# ---------- Database ----------

POSTGRES_USER=simplevtt
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=simplevtt

# ---------- Backups ----------

# Cron expression (UTC) for the backup sidecar.
BACKUP_CRON=0 3 * * *
KEEP_DAILY=7
KEEP_WEEKLY=4

# ---------- Demo mode (v2.3.0) ----------
# Public-demo deployment. When DEMO_MODE=true, the lifespan handler
# wipes-and-seeds three demo accounts + a sample campaign on a fixed
# interval. NEVER enable on production — the wipe surgically removes
# any data tagged with the demo emails / campaign name. See
# docs/plans/demo-mode.md for the full design.
DEMO_MODE=false
# Reset cadence in minutes. Clamped to [5, 1440]. Default 60.
DEMO_RESET_INTERVAL_MINUTES=60
# Run the wipe-and-seed once on boot so the first visitor always sees a
# clean slate (recommended). Default true.
DEMO_RESET_ON_BOOT=true
# Show the three demo credentials on the login page. Set false to keep
# the demo URL accessible but require visitors to know the password.
DEMO_CREDENTIALS_VISIBLE=true
# Whether the demo GM (demo-gm@example.com) is a SITE-admin — the
# /admin portal (user management, audit-log scrub, ban controls),
# NOT the per-campaign GM role (which the demo GM keeps regardless).
# Default true for local/CI (admin showcase + admin-portal harness
# tests). SET false ON ANY PUBLIC/INTERNET-FACING DEMO: the demo
# password is advertised on the login page, so a site-admin demo GM
# lets anyone reach /admin. docker-compose sets this automatically.
DEMO_GM_SITE_ADMIN=true

# ---------- Demo magic-link login (v2.425.0) ----------
# Second gate on top of DEMO_MODE. When TRUE (and DEMO_MODE is also
# true), the URL-based passwordless login endpoints
# (POST /admin/demo/mint-magic-link + GET /demo-login) accept
# requests. Either env var false → endpoints 404. Hard-gated at
# deploy time; not flippable from the admin UI. See
# docs/plans/demo-magic-link.md for the threat model.
SIMPLEVTT_DEMO_MAGIC_LINK_ENABLED=false

# ---------- Cloudflare edge-banning (v2.427.0) ----------
# Outbound integration with Cloudflare's IP Access Rules API for
# moving SimpleVTT-decided bans from the FastAPI layer to the
# Cloudflare edge. Four vars total: three configure the OUTBOUND
# client (token + zone + base URL — base URL defaults to the
# public Cloudflare API); the fourth is the GM-facing button gate.
# See docs/plans/cloudflare-edge-banning.md for the threat model.
#
# Leave both blank unless you operate the ban controls. Only needed
# for the in-app "Ban IP at edge" button or the fail2ban
# `cloudflare-bouncer` action (see FAIL2BAN_ACTION below).
#
# ── How to get CLOUDFLARE_API_TOKEN ──────────────────────────────
#   1. Sign in at https://dash.cloudflare.com and open
#      My Profile → API Tokens
#      (direct: https://dash.cloudflare.com/profile/api-tokens).
#   2. "Create Token" → "Create Custom Token" (Get started).
#   3. Permissions: pick exactly ONE —
#        Zone  ·  Firewall Services  ·  Edit
#      (this is the group that covers IP Access Rules, the
#      `firewall/access_rules/rules` API this client calls).
#   4. Zone Resources: Include → Specific zone → <your domain>.
#      Scope it to the single zone you ban on — don't grant "All
#      zones".
#   5. (Optional) add a Client IP / TTL restriction for extra safety.
#   6. Continue → Create Token → COPY the value (shown once) into
#      CLOUDFLARE_API_TOKEN below.
#   Token scope: Zone:Firewall Services:Edit only — minimal blast
#   radius if it leaks. NEVER reuse a token with broader scope
#   (DNS, WAF, account-level, etc.); generate a fresh scoped one.
#
# ── How to get CLOUDFLARE_ZONE_ID ────────────────────────────────
#   1. In the dashboard, click your domain.
#   2. On the Overview page, find the "API" box in the lower-right
#      sidebar — "Zone ID" is listed there. Copy it.
#   (A zone = one domain. If you ban across several domains you need
#   one SimpleVTT deploy / token+zone pair per zone.)
#
# ── Verify before relying on it (optional) ───────────────────────
#   curl -s "https://api.cloudflare.com/client/v4/zones/<ZONE_ID>/firewall/access_rules/rules?per_page=1" \
#        -H "Authorization: Bearer <TOKEN>" | head -c 400
#   A JSON body with "success": true means the token + zone work.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Leave the default for production; override to the wiremock URL
# when developing against the dev compose profile:
#   CLOUDFLARE_API_BASE_URL=http://cloudflare-mock:8080/client/v4
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4
# GM-facing "Ban IP at edge" button gate. False by default; even
# with the client configured, the in-app UI stays hidden until you
# flip this on. Lets operators run the CrowdSec → Cloudflare
# bouncer path without exposing the in-app affordance.
SIMPLEVTT_CLOUDFLARE_BANNING_ENABLED=false

# ---------- Audit logging / IP attribution (v2.424.0) ----------
# Number of trusted X-Forwarded-For hops behind the app. The audit
# logger (app/audit_log.py) trusts the header only when this is
# positive — set 1 if exactly one reverse proxy is in front of
# SimpleVTT, 2 if there are two, etc. Default 0 (never trust the
# header). See docs/plans/fail2ban-crowdsec-integration.md.
TRUSTED_PROXY_HOPS=0

# Trust Cloudflare's CF-Connecting-IP header for the real visitor IP.
# This is the RIGHT setting behind a Cloudflare Tunnel: cloudflared
# usually sends only CF-Connecting-IP (no usable X-Forwarded-For), so
# without this the app records the Cloudflare/tunnel address instead
# of your visitors'. Takes precedence over X-Forwarded-For when set.
# SECURITY: enable ONLY when the origin is reachable *only* via
# Cloudflare (a tunnel, or an origin firewalled to Cloudflare IPs) —
# otherwise an attacker hitting the origin directly could spoof their
# IP by sending this header. Default false.
TRUST_CF_CONNECTING_IP=false

# v2.469.0 — fail2ban Phase 4a. Where the simplevtt.audit logger
# tees its canonical event lines (alongside stdout). The default
# resolves to the shared `audit_logs` named volume in docker-
# compose.yml so the fail2ban service in Phase 4b can tail it
# read-only. Set to empty to disable the file handler (stdout-only).
# Docker-compose sets this automatically; only override on a non-
# compose deploy where you point at a different host path.
# AUDIT_LOG_PATH=/var/log/simplevtt/audit.log

# v2.480.0 — opt-in per-request visitor logging. When `true`, the app
# emits a `visitor.request` audit event for EVERY HTTP request (path,
# method, status, response time, ip, ua) — full visitor accounting for
# operators behind a Cloudflare Tunnel. DEFAULT OFF: per-request
# logging is high-volume + privacy-sensitive (see docs/wiki/privacy.md).
# Requires TRUSTED_PROXY_HOPS>=1 to take effect — without a trusted hop
# the only recordable IP is the proxy's, so the gate stays closed even
# when this is `true`. See app/visitor_log.py.
# VISITOR_REQUEST_LOG_ENABLED=false

# v2.482.0 — GDPR Article 15/20 self-serve data export
# (GET /api/users/me/export). Per-user cooldown between exports, in
# seconds (default 24h). Set to 0 to disable the rate limit entirely.
# Best-effort in-process limit; bypassed under TEST_MODE.
# USER_DATA_EXPORT_COOLDOWN_SECONDS=86400

# ---------- fail2ban thresholds (v2.471.0 — Phase 4c) ----------
# Tunable thresholds for the docker-compose fail2ban service (Phase
# 4b). Only consumed when the --profile fail2ban service is up;
# default deploys ignore them. The render-jail.sh entrypoint
# envsubsts these values into the jail config at container start.
# See docs/plans/fail2ban-crowdsec-integration.md Phase 4c.
#
# Login-failure jail (auth.login_failed / api.unauthorized /
# api.forbidden + demo_magic_link.verify_rejected per filter.d/
# simplevtt-auth.conf):
FAIL2BAN_LOGIN_MAXRETRY=5
FAIL2BAN_LOGIN_FINDTIME=5m
FAIL2BAN_LOGIN_BANTIME=1h
#
# Magic-link replay is never legit — first offense → 24h ban.
# Reserved for the Phase 4c+ dedicated jail; not yet wired into the
# v2.424.0 reference jail.
FAIL2BAN_MAGIC_LINK_REPLAY_BANTIME=24h
#
# API-probe jail (cross-path 401/403 scanning).
FAIL2BAN_API_PROBE_MAXRETRY=20
#
# Fallback default bantime if a jail doesn't specify one.
FAIL2BAN_DEFAULT_BANTIME=1h
#
# v2.477.0 — Phase 5. Scanner-detection jail (simplevtt-scanner).
# Bans IPs that hit too many invalid URLs (404s) in a short window —
# the classic scanner / abuse footprint. v2.488.3 lowered the default
# from 20 to 10 per 5 min: a casual user clicking around generally hits
# 0–3 404s, so 10 catches persistent probing fast while staying clear
# of real users. Tighter bantime than the auth jail (6h vs 1h) because
# 404 probing is almost-never-ambiguous. Lower further (e.g. 5) to be
# more aggressive, or raise it if real users trip it.
FAIL2BAN_SCANNER_MAXRETRY=10
FAIL2BAN_SCANNER_FINDTIME=5m
FAIL2BAN_SCANNER_BANTIME=6h
#
# v2.481.0 — request-flood jail (simplevtt-flood). Bans IPs that
# fire a high volume of requests in a short window irrespective of
# outcome — a scripted hammer the auth + scanner jails miss (those
# only count failed logins / 404s). Consumes the opt-in
# `visitor.request` event (set VISITOR_REQUEST_LOG_ENABLED=true
# above), so it is GATED OFF by default: the two opt-ins travel
# together. Flip FAIL2BAN_FLOOD_ENABLED=true to arm it. Defaults:
# 300 requests in 1 minute → 1 hour ban (well above human browsing,
# which fires a few dozen requests per page load).
FAIL2BAN_FLOOD_ENABLED=false
FAIL2BAN_FLOOD_MAXRETRY=300
FAIL2BAN_FLOOD_FINDTIME=1m
FAIL2BAN_FLOOD_BANTIME=1h
#
# v2.495.4 — jail allowlist. Space-separated IPs / CIDRs appended to
# every jail's [DEFAULT] ignoreip (localhost is always kept). Use it to
# exempt a trusted host that legitimately trips a jail — e.g. a
# smoke-test / monitoring box running the harness against the public
# deploy, which self-bans on its own error-path 401/403/404 tests.
# Empty by default. CAUTION: an allowlisted IP is exempt from ALL jails,
# so don't list a shared / NAT / Cloudflare-egress address unless
# everything behind it is trusted. Example:
#   FAIL2BAN_IGNOREIP=203.0.113.7 198.51.100.0/24
FAIL2BAN_IGNOREIP=
#
# v2.472.0 — Phase 4d. Ban-action selector. Default uses fail2ban's
# built-in `%(action_)s` shorthand which resolves to iptables /
# nftables inside the container. Override to a bouncer action to
# push bans somewhere with real reach:
#   FAIL2BAN_ACTION=%(action_)s           # Default
#   FAIL2BAN_ACTION=cloudflare-bouncer    # Phase 4d (this commit)
#   FAIL2BAN_ACTION=ipset-bouncer         # Phase 4e (requires
#                                          # FAIL2BAN_PRIVILEGED=true
#                                          # + NET_ADMIN cap)
# Multiple actions are space-separated.
# Default leaves the image's iptables target alone.
FAIL2BAN_ACTION=%(action_)s

# ---------- Test mode (v2.49.12) ----------
# Encounter-simulation test suite knobs. See
# docs/plans/encounter-sim-test-suite.md. Leave OFF on any deployment
# that isn't a CI test runner.
#
# TEST_MODE — when true, mounts /api/test/* endpoints (e.g. dice seed
# control). The endpoints DO NOT exist when this is off; production
# leaves it false.
TEST_MODE=false
# DICE_SEED — when an integer, every gameplay dice roll is reproducible
# from this seed at boot. Leave unset for normal entropy. Mostly useful
# inside CI where TEST_MODE is also on (so tests can re-seed mid-run
# via /api/test/dice/seed). docker-compose passes both through.
#DICE_SEED=
